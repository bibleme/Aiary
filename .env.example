OPENAI_API_KEY=your_openai_api_key
DATABASE_URL=postgresql+asyncpg://aiary_user:aiary_pass@localhost:5432/aiary_db
SECRET_KEY=change_this_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
IMAGE_UPLOAD_DIR=/home/ubuntu/Aiary/media/images
DAILY_DIARY_MODEL_DIR=/home/ubuntu/Aiary/models/daily_diary/aliases/current
DAILY_DIARY_RUNTIME_VERSION=realistic_daily
PUBLIC_BASE_URL=http://your-server-ip:8000
MONTHLY_REPORT_MIN_DIARIES=5
MONTHLY_REPORT_USE_JSON_FALLBACK=true
MONTHLY_REPORT_USE_GPT_SCENE=true
MONTHLY_REPORT_USE_GPT_REPORT=true
MONTHLY_REPORT_OPENAI_MODEL=gpt-4.1-mini
MONTHLY_REPORT_SCENE_OPENAI_MODEL=gpt-4.1-mini
CV_ENABLED=True
CV_LOAD_POSE_MODEL=False
CV_USE_SIGLIP_EMBEDDINGS=False
CV_WORKER_BATCH_LIMIT=1
STORAGE_BACKEND=s3
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_PREFIX=users
AWS_S3_PUBLIC_BASE_URL=
